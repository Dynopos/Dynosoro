APP_NAME="Dyno SEO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seo.dynolead.my
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
CANONICAL_REDIRECT=true

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dynoseo
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1200
QUEUE_VIA_SCHEDULER=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Dyno SEO"

# Google Cloud / Vertex AI. Kunci service account: tampal base64 fail JSON dalam
# GOOGLE_CREDENTIALS_BASE64 (paling mudah di Forge), ATAU letak fail di luar repo dan isi path.
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
# Kosong = sama dengan GCP_REGION. Isi us-central1 jika Imagen tiada di rantau itu.
GCP_IMAGE_REGION=
GOOGLE_CREDENTIALS_BASE64=
GOOGLE_APPLICATION_CREDENTIALS=
# Pilihan, untuk ujian sahaja (gcloud auth print-access-token). Tamat dalam 1 jam.
VERTEX_ACCESS_TOKEN=
GEMINI_MODEL_WRITE=gemini-2.5-flash
GEMINI_MODEL_CHECK=gemini-2.5-flash-lite
IMAGEN_MODEL=imagen-4.0-fast-generate-001
GEMINI_THINKING_BUDGET_WRITE=
GEMINI_THINKING_BUDGET_CHECK=0

# Had kos
AI_MONTHLY_BUDGET_MYR=300
MAX_DAILY_AI_CALLS=300
MAX_ARTICLES_PER_SITE_PER_DAY=1

# GitHub (fine-grained token, Contents: read & write, repo website sahaja)
GITHUB_TOKEN=
GITHUB_TOKEN_EXPIRES_AT=

# IndexNow (Bing/Yandex). Rentetan rawak 32 aksara, contoh dari: openssl rand -hex 16
INDEXNOW_KEY=
